<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks plain HTTP by default. The development API runs on
         http://10.0.2.2:5199 (the emulator's alias for this machine), so
         cleartext has to be allowed - but ONLY in debug builds. Release builds
         inherit the secure default and can talk to HTTPS only. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
