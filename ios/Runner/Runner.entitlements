<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple will not deliver a push to a build without this.

	     "production", not "development", and the distinction is the one that
	     catches everybody: a TestFlight build runs against the PRODUCTION
	     APNs environment, despite being a test build. With "development" here
	     the phone registers a sandbox token while the server sends to
	     production, and nothing arrives - no error on either side.

	     Every build of this app reaches a device through TestFlight or the
	     App Store, both of which are production. There is no Mac in this
	     project to produce a development build, so there is no case where
	     "development" would be the right value. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
