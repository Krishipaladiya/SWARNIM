<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Swarnim Connect</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>swarnim_connect</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ============================================================
	     Permission strings.

	     iOS does not ask and then refuse: calling the camera, the photo
	     library or location with no usage string is an immediate hard
	     crash, with a console message nobody sees on a test device. The
	     app already used all three, so it would have died the first time
	     anybody filed a complaint with a photo or finished a job.

	     The wording matters too - it is what the customer reads in the
	     system prompt, and Apple rejects builds whose strings do not say
	     what the data is actually for.
	     ============================================================ -->

	<key>NSCameraUsageDescription</key>
	<string>Swarnim Connect uses the camera so you can photograph a problem in your flat, and so site staff can photograph completed work.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Swarnim Connect needs access to your photos so you can attach a picture of a problem to a complaint.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>Swarnim Connect records audio only as part of a video you choose to attach to a complaint.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>Swarnim Connect uses the local network to connect to services when required for app functionality.</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Swarnim Connect confirms site staff are at the property when they request a closure code from the customer. Your location is not used when you are signed in as a resident.</string>

	<!-- Cleartext HTTP to a development API on the same Wi-Fi.

	     NSAllowsLocalNetworking permits plain HTTP to LAN addresses and
	     .local hostnames only. It is deliberately NOT
	     NSAllowsArbitraryLoads, which would switch off transport security
	     for the whole internet and is also an App Store review question
	     you do not want to answer. Production must be HTTPS regardless. -->
	<!--
		Declares the app uses no non-exempt encryption, which is true: it
		talks HTTPS and keeps tokens in the Keychain, both of which are
		Apple's own exempt crypto. Without this key App Store Connect stops
		every single upload to ask the export-compliance question by hand,
		and the build sits there unable to reach TestFlight until somebody
		notices and answers it.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
